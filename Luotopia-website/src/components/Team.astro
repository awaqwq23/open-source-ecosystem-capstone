---
<section class="team" id="team">
  <header class="team__head" data-reveal-stagger>
    <p class="eyebrow"><span class="num">04</span>&nbsp;／&nbsp;04&nbsp;&nbsp;·&nbsp;&nbsp;团队</p>
    <h2 class="team__title">ClosedWHU <em>members</em></h2>
    <p class="team__sub">武汉大学开源社区 ClosedWHU 的 GitHub 组织成员。头像与主页来自 GitHub，点击卡片可查看个人主页。</p>
  </header>

  <div class="team__grid">
    {members.map((m) => (
      <a class="team__card" href={m.url} target="_blank" rel="noopener" data-reveal="fade">
        <img class="team__avatar" src={m.avatar} alt={`${m.login} 的 GitHub 头像`} loading="lazy" />
        <h3 class="team__name">{m.name || m.login}</h3>
        <p class="team__role">
          <span>@{m.login}</span>
          <span class="team__role-en">GitHub member</span>
        </p>
        <span class="team__rule"></span>
      </a>
    ))}
  </div>

  <p class="team__foot" data-reveal="fade">
    <a href="https://github.com/ClosedWHU" target="_blank" rel="noopener">github.com/ClosedWHU</a>
  </p>
</section>

<style>
  .team { padding: var(--section-y) clamp(1.25rem,5vw,var(--gutter)); max-width: var(--wide); margin-inline: auto; }
  .team__head { display: grid; gap: 1.2rem; margin-bottom: clamp(2.5rem,6vw,4rem); max-width: 56ch; }
  .team__title { font-family: var(--ff-serif-cn); font-weight: 600; font-size: var(--step-3); letter-spacing: .06em; }
  .team__title em { font-style: normal; color: var(--accent-2); font-family: var(--ff-display); }
  .team__sub { color: var(--fg-2); font-size: .95rem; line-height: 1.75; font-weight: 300; max-width: 46ch; }

  .team__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: clamp(.6rem,2vw,1.4rem); }
  .team__card {
    border: 1px solid var(--line); background: transparent;
    padding: clamp(1.15rem,2.4vw,1.7rem) clamp(1rem,2vw,1.4rem);
    display: flex; flex-direction: column; gap: .8rem;
    min-height: 13rem;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .team__card:hover { border-color: var(--line-strong); background: color-mix(in srgb, var(--ink-2) 50%, transparent); transform: translateY(-3px); }
  .team__avatar {
    width: 4.2rem; height: 4.2rem; border-radius: 50%; object-fit: cover;
    border: 1px solid var(--line-strong);
    background: var(--ink-3);
    margin-bottom: .6rem;
  }
  .team__name {
    font-family: var(--ff-display); font-style: italic; font-weight: 600; font-size: clamp(1.1rem,1.8vw,1.35rem); color: var(--fg);
    overflow-wrap: anywhere;
  }
  .team__role { display: flex; flex-direction: column; gap: .1rem; }
  .team__role span:first-child { font-size: .9rem; color: var(--fg-2); overflow-wrap: anywhere; }
  .team__role-en { font-size: .68rem !important; letter-spacing: .18em; text-transform: uppercase; color: var(--fg-3) !important; }
  .team__rule { height: 1px; background: var(--line); margin-top: .4rem; }

  .team__foot { margin-top: clamp(2rem,5vw,3rem); color: var(--fg-3); font-size: .8rem; letter-spacing: .12em; }
  .team__foot a { color: inherit; transition: color var(--dur) var(--ease); }
  .team__foot a:hover { color: var(--accent); }

  @media (max-width: 520px) { .team__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 390px) { .team__grid { grid-template-columns: 1fr; } }
</style>
