---
// 团队介绍：次要板块。团队信息未公开，做 monochrome 杂志感网格占位（lorem 假名/职务），后续替换为真实成员。
const members = [
  { name: "Loris Vane", role_cn: "发起 / 产品", role_en: "Founder", initials: "LV" },
  { name: "Iruma Sato", role_cn: "客户端 / Flutter", role_en: "Client Lead", initials: "IS" },
  { name: "Pell Reim", role_cn: "服务端 / Go", role_en: "Backend Lead", initials: "PR" },
  { name: "Vela Nori", role_cn: "设计 / 视觉", role_en: "Design", initials: "VN" },
];
---
<section class="team" id="team">
  <header class="team__head" data-reveal-stagger>
    <p class="eyebrow"><span class="num">04</span>&nbsp;／&nbsp;04&nbsp;&nbsp;·&nbsp;&nbsp;团队</p>
    <h2 class="team__title">一群<em>珞珈山下</em>的人</h2>
    <p class="team__sub">这里暂以代号占位。待团队信息公开后，将以真实姓名与职责替换下列卡片。</p>
  </header>

  <div class="team__grid">
    {members.map((m) => (
      <article class="team__card" data-reveal="fade">
        <div class="team__avatar" aria-hidden="true">{m.initials}</div>
        <h3 class="team__name">{m.name}</h3>
        <p class="team__role"><span>{m.role_cn}</span><span class="team__role-en">{m.role_en}</span></p>
        <div class="team__rule"></div>
      </article>
    ))}
  </div>

  <p class="team__foot" data-reveal="fade">openwhu 社区 · 由武大学生与校外贡献者共同维护</p>
</section>

<style>
  .team { padding: var(--section-y) clamp(1.25rem,5vw,var(--gutter)); max-width: var(--wide); margin-inline: auto; }
  .team__head { display: grid; gap: 1.2rem; margin-bottom: clamp(2.5rem,6vw,4rem); max-width: 56ch; }
  .team__title { font-family: var(--ff-serif-cn); font-weight: 600; font-size: var(--step-3); letter-spacing: .06em; }
  .team__title em { font-style: normal; color: var(--accent-2); font-family: var(--ff-display); }
  .team__sub { color: var(--fg-2); font-size: .95rem; line-height: 1.75; font-weight: 300; max-width: 46ch; }

  .team__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(.6rem,2vw,1.4rem); }
  .team__card {
    border: 1px solid var(--line); background: transparent;
    padding: clamp(1.4rem,3vw,2.2rem) clamp(1rem,2vw,1.6rem);
    display: flex; flex-direction: column; gap: .8rem;
    transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .team__card:hover { border-color: var(--line-strong); background: color-mix(in srgb, var(--ink-2) 50%, transparent); }
  .team__avatar {
    width: 4.2rem; height: 4.2rem; border-radius: 50%;
    display: grid; place-items: center;
    font-family: var(--ff-display); font-style: italic; font-weight: 600; font-size: 1.4rem;
    color: var(--fg); border: 1px solid var(--line-strong);
    background: radial-gradient(circle at 30% 25%, color-mix(in srgb, var(--luojia-blue) 60%, var(--ink-3)), var(--ink));
    margin-bottom: .6rem;
  }
  .team__name { font-family: var(--ff-display); font-style: italic; font-weight: 600; font-size: 1.4rem; color: var(--fg); }
  .team__role { display: flex; flex-direction: column; gap: .1rem; }
  .team__role span:first-child { font-family: var(--ff-serif-cn); font-size: .95rem; color: var(--fg-2); }
  .team__role-en { font-size: .68rem !important; letter-spacing: .18em; text-transform: uppercase; color: var(--fg-3) !important; }
  .team__rule { height: 1px; background: var(--line); margin-top: .4rem; }

  .team__foot { margin-top: clamp(2rem,5vw,3rem); color: var(--fg-3); font-size: .8rem; letter-spacing: .12em; }

  @media (max-width: 900px) { .team__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .team__grid { grid-template-columns: 1fr; } }
</style>
