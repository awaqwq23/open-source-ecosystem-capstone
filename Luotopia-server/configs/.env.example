# =============================================================================
# Luotopia Server 配置模板
# 复制本文件为 .env 后按需修改：
#   cp configs/.env.example configs/.env
# =============================================================================

# 当前运行环境名称：development / production / test
LUOTOPIA_ENV=development

# HTTP 服务监听地址和端口
LUOTOPIA_HTTP_ADDR=:8080

# HTTP 请求读取超时时间，单位秒
LUOTOPIA_HTTP_READ_TIMEOUT=5

# HTTP 响应写入超时时间，单位秒
LUOTOPIA_HTTP_WRITE_TIMEOUT=15

# 服务优雅关闭等待时间，单位秒
LUOTOPIA_HTTP_SHUTDOWN_TIMEOUT=10

# PostgreSQL 数据库连接地址。留空则账号模块使用内存仓储
LUOTOPIA_DATABASE_URL=postgres://luotopia:luotopia@127.0.0.1:5432/luotopia?sslmode=disable
LUOTOPIA_CONTAINER_DATABASE_URL=postgres://luotopia:luotopia@postgres:5432/luotopia?sslmode=disable

# Redis 连接地址。留空则验证码使用内存存储
LUOTOPIA_REDIS_URL=redis://127.0.0.1:6379/0
LUOTOPIA_CONTAINER_REDIS_URL=redis://redis:6379/0

# S3 兼容对象存储 Endpoint，例如 127.0.0.1:9000 或 cos.ap-guangzhou.myqcloud.com
LUOTOPIA_STORAGE_ENDPOINT=127.0.0.1:9000

# 对象存储桶名称
LUOTOPIA_STORAGE_BUCKET=luotopia-dev

# 对象存储区域
LUOTOPIA_STORAGE_REGION=local

# 对象存储访问凭证
LUOTOPIA_STORAGE_ACCESS_KEY=
LUOTOPIA_STORAGE_SECRET_KEY=

# CDN 或对象存储公开访问根地址，不带末尾斜杠
LUOTOPIA_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/luotopia-dev

# 本地 MinIO 通常为 false，云厂商 HTTPS 通常为 true
LUOTOPIA_STORAGE_USE_SSL=false

# MinIO 和多数 S3 兼容服务使用 true；AWS S3 可按需要设为 false
LUOTOPIA_STORAGE_FORCE_PATH_STYLE=true

# 访问令牌签名密钥，生产环境必须更换
LUOTOPIA_AUTH_ACCESS_TOKEN_SECRET=change-me

# 访问令牌有效期，单位秒
LUOTOPIA_AUTH_ACCESS_TOKEN_TTL=600

# 刷新令牌有效期，单位秒
LUOTOPIA_AUTH_REFRESH_TOKEN_TTL=2592000

# 后台管理员身份（通过手机号或邮箱指定，两者留一则无管理员）
# 拥有此手机号/邮箱的用户会自动获得后台管理权限
LUOTOPIA_ADMIN_PHONE=
LUOTOPIA_ADMIN_EMAIL=

# =============================================================================
# 天气模块（和风天气）
# =============================================================================

# 和风天气 API Key（留空则天气模块不启用）
LUOTOPIA_WEATHER_API_KEY=
# 和风天气 API Host（控制台分配的专属域名，如 abc123.def.qweatherapi.com。必填）
LUOTOPIA_WEATHER_API_HOST=

# 天气查询位置（武汉大学经纬度）
LUOTOPIA_WEATHER_LOCATION=114.36,30.54

# 天气缓存刷新间隔，单位秒
LUOTOPIA_WEATHER_CACHE_TTL=900

# =============================================================================
# 短信验证码（腾讯云 SMS）
# =============================================================================

# 腾讯云短信 SecretId
LUOTOPIA_TENCENT_SMS_SECRET_ID=

# 腾讯云短信 SecretKey
LUOTOPIA_TENCENT_SMS_SECRET_KEY=

# 腾讯云短信服务区域
LUOTOPIA_TENCENT_SMS_REGION=ap-guangzhou

# 腾讯云短信应用 ID
LUOTOPIA_TENCENT_SMS_APP_ID=

# 腾讯云短信签名名称
LUOTOPIA_TENCENT_SMS_SIGN_NAME=

# 腾讯云短信验证码模板 ID
LUOTOPIA_TENCENT_SMS_TEMPLATE_ID=

# =============================================================================
# 邮件验证码（SMTP）
# =============================================================================

# 邮件验证码 SMTP 服务器地址
LUOTOPIA_SMTP_HOST=

# 邮件验证码 SMTP 服务器端口
LUOTOPIA_SMTP_PORT=587

# QQ 邮箱 SMTP 登录账号
LUOTOPIA_SMTP_USERNAME=

# QQ 邮箱 SMTP 授权码
LUOTOPIA_SMTP_PASSWORD=

# 邮件验证码信封发件邮箱
LUOTOPIA_SMTP_FROM=
