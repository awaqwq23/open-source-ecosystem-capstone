LUOTOPIA_ENV=development
LUOTOPIA_HTTP_ADDR=:8080
LUOTOPIA_HTTP_READ_TIMEOUT=5
LUOTOPIA_HTTP_WRITE_TIMEOUT=10
LUOTOPIA_HTTP_SHUTDOWN_TIMEOUT=10
LUOTOPIA_DATABASE_URL=postgres://luotopia:luotopia@postgres:5432/luotopia?sslmode=disable
LUOTOPIA_REDIS_URL=redis://redis:6379/0
LUOTOPIA_STORAGE_BUCKET=luotopia-dev
LUOTOPIA_STORAGE_REGION=local
LUOTOPIA_AUTH_ACCESS_TOKEN_SECRET=change-me
LUOTOPIA_AUTH_ACCESS_TOKEN_TTL=600
LUOTOPIA_AUTH_REFRESH_TOKEN_TTL=2592000
LUOTOPIA_TENCENT_SMS_SECRET_ID=
LUOTOPIA_TENCENT_SMS_SECRET_KEY=
LUOTOPIA_TENCENT_SMS_REGION=ap-guangzhou
LUOTOPIA_TENCENT_SMS_APP_ID=
LUOTOPIA_TENCENT_SMS_SIGN_NAME=
LUOTOPIA_TENCENT_SMS_TEMPLATE_ID=
LUOTOPIA_SMTP_HOST=
LUOTOPIA_SMTP_PORT=587
LUOTOPIA_SMTP_USERNAME=
LUOTOPIA_SMTP_PASSWORD=
LUOTOPIA_SMTP_FROM=
