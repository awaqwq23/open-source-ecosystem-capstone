---
import { Globe, Monitor } from "lucide-astro";
import * as si from "simple-icons";

// name -> simple-icons path
const named: Record<string, string> = {
  apple: si.siApple.path,
  android: si.siAndroid.path,
  linux: si.siLinux.path,
};
const lucide: Record<string, typeof Monitor> = {
  windows: Monitor,
  web: Globe,
};

export interface Props {
  /** apple | android | linux | windows | web */
  name: string;
  class?: string;
  size?: number | string;
}
const { name, class: cls = "", size = "100%" } = Astro.props;

const path = named[name];
const LucideIcon = lucide[name];
---

{path ? (
  <svg
    class={cls}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    role="img"
    aria-hidden="true"
    focusable="false"
    fill="currentColor"
  ><path d={path} /></svg>
) : LucideIcon ? (
  <LucideIcon class={cls} size={Number(size) || undefined} aria-hidden="true" focusable="false" />
) : null}
